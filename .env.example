# Copy to .env. Every setting is optional; see the Configuration section of README.md.

# Gemini writes the plain-language stewardship brief. Without a key, a deterministic narrative is used.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# BHUMI_LLM=off

# Ethereum Sepolia dMRV Registry Contract Address (chainId: 11155111)
# BHUMI_SEPOLIA_CONTRACT=0x7F4e9B2c1D8a3E5f6A0b9C4d2E1f8A7b6C5d4E3f

# Earth Engine: run `earthengine authenticate` once. Set a cloud project if your account needs one.
# BHUMI_EE_PROJECT=

# The Fields of the World CLI, for running the field boundary model on fresh imagery
# BHUMI_FTW=

# Pause between investigation steps, in milliseconds
# DEMO_PACING=550
